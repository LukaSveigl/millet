(* A simple addition. *)
let add (x: int) (y: int) = x + y

(* A partially applied div function. *)
let padiv (x: int) : int -> int = function
  | 0 -> 0
  | y -> x / y

(* A composite partially applied function. *)
let composite (f: int -> int -> int) (x: int) : int -> int = function
 | 0 -> -1
 | y -> f x y

run 1 + 2

run add 1 2

run padiv 3 1

run padiv 3 (id 1)

run composite padiv 3 1

run composite padiv 3 (id 1)