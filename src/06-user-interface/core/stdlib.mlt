let 'a. ( = ) (x: 'a) (y: 'a) : bool = __compare_eq__ (x, y)
let 'a. ( < ) (x: 'a) (y: 'a) : bool = __compare_lt__ (x, y)
let 'a. ( > ) (x: 'a) (y: 'a) : bool = __compare_gt__ (x, y)
let 'a. ( <= ) (x: 'a) (y: 'a) : bool = __compare_le__ (x, y)
let 'a. ( >= ) (x: 'a) (y: 'a) : bool = __compare_ge__ (x, y)
let 'a. ( <> ) (x: 'a) (y: 'a) : bool = __compare_ne__ (x, y)
let ( + ) (x: int) (y: int) : int = __integer_add__ (x, y)
let ( * ) (x: int) (y: int) : int = __integer_mul__ (x, y)
let ( - ) (x: int) (y: int) : int = __integer_sub__ (x, y)
let ( / ) (x: int) (y: int) : int = __integer_div__ (x, y)
let ( mod ) (x: int) (y: int) : int = __integer_mod__ (x, y)
let ( ~- ) (x: int) : int = __integer_neg__ x
let ( +. ) (x: float) (y: float) : float = __float_add__ (x, y)
let ( *. ) (x: float) (y: float) : float = __float_mul__ (x, y)
let ( -. ) (x: float) (y: float) : float = __float_sub__ (x, y)
let ( /. ) (x: float) (y: float) : float = __float_div__ (x, y)
let ( ** ) (x: float) (y: float) : float = __float_pow__ (x, y)
let ( ~-. ) (x: float) : float = __float_neg__ x

(* let 'a. absurd void : empty -> 'a = fun void -> (match void with) *)

(* Booleans *)
let not (x: bool) : bool = if x then false else true

type 'a option = None | Some of 'a

let rec 'a. 'b. assoc (x: 'a): ('a * 'b) list -> 'b option = function
  | [] -> None
  | (key, v) :: lst -> if x = key then Some v else assoc x lst

let rec range (m: int) (n: int) : int list  =
  if m > n then
    []
  else
    m :: range (m + 1) n

let 'a. reverse (lst: 'a list): 'a list =
  let rec reverse_acc (acc: 'a list): 'a list -> 'a list = function
    | [] -> acc
    | x :: xs -> reverse_acc (x :: acc) xs
  in
  reverse_acc [] lst

let rec 'a. 'b. map (f: 'a -> 'b): 'a list -> 'b list = function
  | [] -> []
  | x :: xs ->
    let y = f x in
    let ys = map f xs in
    y :: ys

let 'a. hd: 'a list -> 'a = function
  | x :: _ -> x

let 'a. tl: 'a list -> 'a list = function
  | x :: xs -> xs

let 'a. take (f: int -> 'a) (k: int): 'a list =
  let r = range 0 k in map f r

let rec 'a. 'b. fold_left (f: 'b -> 'a -> 'b) (acc: 'b) : 'a list -> 'b = function
  | [] -> acc
  | y :: ys ->
    let acc' = f acc y in
    fold_left f acc' ys

let rec 'a. 'b. fold_right (f: 'a -> 'b -> 'b) (xs: 'a list) (acc: 'b) : 'b =
  match xs with
    | [] -> acc
    | x :: xs ->
      let acc' = fold_right f xs acc in
      f x acc'
    
let rec 'a. iter (f: 'a -> unit) : 'a list -> unit = function
  | [] -> ()
  | x :: xs -> f x; iter f xs

let rec 'a. forall (p: 'a -> bool) : 'a list -> bool = function
  | [] -> true
  | x :: xs -> if p x then forall p xs else false

let rec 'a. exists (p: 'a -> bool) : 'a list -> bool = function
  | [] -> false
  | x :: xs -> if p x then true else exists p xs

let 'a. mem (x: 'a) : 'a list -> bool = exists (fun x' -> x = x')

let rec 'a. filter (p: 'a -> bool) : 'a list -> 'a list = function
  | [] -> []
  | x :: xs ->
    if p x then (x :: filter p xs) else filter p xs

let 'a. complement (xs: 'a list) (ys: 'a list) : 'a list = filter (fun x -> not (mem x ys)) xs
let 'a. intersection (xs: 'a list) (ys: 'a list) : 'a list = filter (fun x -> mem x ys) xs
let rec 'a. 'b. zip (xs: 'a list) (ys: 'b list) : ('a * 'b) list =
  match (xs, ys) with
  | ([], []) -> []
  | (x :: xs, y :: ys) -> (x, y) :: (zip xs ys)

let rec 'a. 'b. unzip : ('a * 'b) list -> ('a list * 'b list) = function
  | [] -> ([], [])
  | (x, y) :: xys ->
    let xs, ys = unzip xys in
    (x :: xs, y :: ys)

let rec 'a. (@) (xs: 'a list) (ys: 'a list): 'a list =
  match xs with
  | [] -> ys
  | x :: xs -> x :: (xs @ ys)

let rec 'a. length : 'a list -> int = function
  | [] -> 0
  | x :: xs -> length xs + 1

let rec 'a. nth (x::xs : 'a list) (n: int) : 'a =
  if n = 0 then x else nth xs (n - 1)

(* Basic functions *)
let abs (x: int) : int = if x < 0 then -x else x
let 'a. min (x: 'a) (y: 'a) : 'a = if x < y then x else y
let 'a. max (x: 'a) (y: 'a) : 'a = if x < y then y else x
let rec gcd (m: int) (n: int) : int =
  match n with
  | 0 -> m
  | _ -> let g = gcd n in g (m mod n)

let rec lcm (m: int) (n: int) : int =
  let d = gcd m n in (m * n) / d

let odd (x: int) : bool = (x mod 2) = 1
let even (x: int) : bool = (x mod 2) = 0
let 'a. id (x: 'a) : 'a = x
let 'a. 'b. 'c. compose (f: 'b -> 'c) (g: 'a -> 'b) (x: 'a) : 'c = f (g x)
let 'a. 'b. (|>) (x: 'a) (f: 'a -> 'b) : 'b = f x
let 'a. ignore (_: 'a) : unit = ()
let 'a. 'b. fst (x, _: 'a * 'b) : 'a = x
let 'a. 'b. snd (_, y: 'a * 'b) : 'b = y
  
let 'a. return (x: 'a) : 'a = x
